{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the main and overlay windows",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:allow-version",
    "core:app:allow-name",
    "shell:allow-open",
    "store:default",
    "fs:default",
    "global-shortcut:default"
  ]
}
