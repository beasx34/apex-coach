{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apex Coach",
  "version": "0.1.0",
  "identifier": "ai.apexcoach.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Apex Coach",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Apex Coach overlay",
        "width": 420,
        "height": 160,
        "x": 1480,
        "y": 880,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Real-time Apex Legends coach with HUD OCR + Gemini",
    "longDescription": "Apex Coach captures your HUD via OCR, builds a live game-state context, and asks Google Gemini for short tactical tips that appear in a transparent overlay window on top of the game."
  }
}
